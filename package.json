{
  "name": "typescript-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "A living TypeScript monorepo template using Yarn Workspaces",
  "workspaces": {
    "packages": [
      "workspaces/shared/*"
    ]
  },
  "scripts": {
    "build": "yarn workspaces foreach -A run build",
    "test": "yarn workspaces foreach -A run test",
    "lint": "yarn workspaces foreach -A run lint",
    "lint:fix": "yarn workspaces foreach -A run lint:fix",
    "clean": "yarn workspaces foreach -A run clean",
    "clean:deep": "rm -rf node_modules */node_modules yarn.lock",
    "dev": "yarn workspaces foreach -A run dev",
    "typecheck": "yarn workspaces foreach -A run typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "yarn": "^1.22.22"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "packageManager": "yarn@1.22.22"
}
